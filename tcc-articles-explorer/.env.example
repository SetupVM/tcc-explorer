# Copie este arquivo para .env (na mesma pasta) e preencha.
# O .env está no .gitignore: nunca envie sua chave para o GitHub.

# ---------------------------------------------------------------- LLM
# Necessário apenas para a área "3 · Perguntar" (respostas e sugestões de TCC).
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini
# Opcional: usar um LLM local do Ollama em vez da OpenAI (respostas mais fracas
# com modelos pequenos). Nesse caso: OPENAI_API_KEY=ollama e OPENAI_MODELO=llama3.2
# OPENAI_BASE_URL=http://localhost:11434/v1
# Use -1 para modelos que não aceitam o parâmetro temperature.
OPENAI_TEMPERATURA=0.1
OPENAI_MAX_TOKENS=1800

# ---------------------------------------------------------------- Embeddings (locais)
# Multilíngue: perguntas em português encontram trechos em inglês.
# Alternativa leve (~0,5 GB): intfloat/multilingual-e5-small
# Trocar o modelo exige recriar o índice (o app oferece o botão).
EMBEDDING_MODELO=BAAI/bge-m3
# Tamanho máximo de cada trecho, em caracteres
TAMANHO_TRECHO=1200
TRECHOS_POR_PERGUNTA=8

# ---------------------------------------------------------------- Extração (Docling)
# auto = OCR só onde não há texto no PDF | pagina_inteira = PDFs digitalizados | desligado
EXTRACAO_OCR=auto
EXTRACAO_FORMULAS=true
EXTRACAO_TABELAS_PRECISAS=true

# ---------------------------------------------------------------- Melhorias depois do Docling
# Segunda leitura das fórmulas com o Dolphin-1.5 (local, ~0,8 GB na 1ª vez)
FORMULAS_SEGUNDA_LEITURA=true
# Comparação opcional com MinerU (instale em .venv-mineru; veja o README).
# MINERU_PYTHON=/caminho/para/.venv-mineru/bin/python
# MINERU_HOME=/caminho/para/cache/mineru
MINERU_TIMEOUT=900
# Título e tema a partir do texto (LLM se houver chave; senão, similaridade local)
INFERIR_METADADOS=true
# Descrição de figuras por modelo de visão local (Ollama). Instale o Ollama e rode:
#   ollama pull qwen2.5vl:7b
DESCREVER_FIGURAS=false
VISAO_URL=http://localhost:11434/v1
VISAO_MODELO=qwen2.5vl:7b

# ---------------------------------------------------------------- Limites de importação
MAX_ARQUIVOS_POR_ENVIO=10
MAX_TAMANHO_MB=50
MAX_PAGINAS=80

# ---------------------------------------------------------------- Pasta de dados
# Padrão: ./dados (PDFs, extrações, catálogo e índice). Deixe comentado para usar o padrão.
# PASTA_DADOS=/caminho/para/dados
